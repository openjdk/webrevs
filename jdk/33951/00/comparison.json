    \/\/ There is harmless concurrency here when reading fields in the AOTCodeEntry.\n+    \/\/ The _loaded field is monotonic. It is set in nmethod::new_nmethod under\n+    \/\/ CodeCache_lock while ciEnv::register_aot_method holds MethodCompileQueue_lock.\n+    \/\/ We might race with other threads which quickly queue and then load\n+    \/\/ the method, and harmlessly conclude that this code entry is still loadable.\n+    \/\/ Even if we manage to queue a second load concurrently,\n+    \/\/ CompileBroker::compile_method_base checks, under the MCQ lock, with\n+    \/\/ compilation_is_in_queue and compilation_is_complete, to avoid duplicate work.\n+    if (entry->is_loaded()) {\n+      return nullptr; \/\/ AOT code for this entry was loaded already by other thread.\n+    }\n+\n+    if (entry->is_verified()) {\n+      \/\/ With VerifyAOTCode AOT code is only verified without installation\n+      assert(VerifyAOTCode, \"sanity\");\n+      return nullptr; \/\/ AOT code was already verified\n+    }\n+\n@@ -1377,1 +1400,1 @@\n-    if (entry != nullptr && entry->has_vectors() && !EnableVectorSupport) {\n+    if (entry->has_vectors() && !EnableVectorSupport) {\n","filename":"src\/hotspot\/share\/code\/aotCodeCache.cpp","additions":24,"deletions":1,"binary":false,"changes":25,"status":"modified"},{"patch":"@@ -2631,2 +2631,1 @@\n-#if INCLUDE_CDS\n-  if (!ServiceThread::has_started()) {\n+  if (CDSConfig::is_using_aot_linked_classes() && !ServiceThread::has_started()) {\n@@ -2639,1 +2638,0 @@\n-#endif\n","filename":"src\/hotspot\/share\/code\/nmethod.cpp","additions":1,"deletions":3,"binary":false,"changes":4,"status":"modified"},{"patch":"@@ -94,12 +94,1 @@\n-    AOTCodeEntry* aot_code_entry = AOTCodeCache::find_code_entry(method, comp_level);\n-    \/\/ There is harmless concurrency here when reading fields in the AOTCodeEntry.\n-    \/\/ The _loaded field is monotonic, going true in ciEnv::register_aot_method under\n-    \/\/ MethodCompileQueue_lock.  We might race with other threads which quickly queue\n-    \/\/ and then load the method, and harmlessly conclude that this code entry is\n-    \/\/ still loadable.  Even if we manage to queue a second load concurrently,\n-    \/\/ CompileBroker::compile_method_base checks, under the MCQ lock, with\n-    \/\/ compilation_is_in_queue and compilation_is_complete, to avoid duplicate work.\n-    if (aot_code_entry != nullptr && !aot_code_entry->is_loaded() &&\n-        !aot_code_entry->not_entrant() && !aot_code_entry->is_verified()) {\n-      return aot_code_entry;\n-    }\n+    return AOTCodeCache::find_code_entry(method, comp_level);\n","filename":"src\/hotspot\/share\/compiler\/compilationPolicy.cpp","additions":1,"deletions":12,"binary":false,"changes":13,"status":"modified"},{"patch":"@@ -219,1 +219,0 @@\n-#if INCLUDE_CDS\n@@ -224,1 +223,0 @@\n-#endif\n","filename":"src\/hotspot\/share\/compiler\/compilerDirectives.cpp","additions":0,"deletions":2,"binary":false,"changes":2,"status":"modified"},{"patch":"@@ -193,1 +193,0 @@\n-#if INCLUDE_CDS\n@@ -202,3 +201,1 @@\n-  } else\n-#endif\n-  if (gen->can_inline_as_constant(card_table_base)) {\n+  } else if (gen->can_inline_as_constant(card_table_base)) {\n","filename":"src\/hotspot\/share\/gc\/shared\/c1\/cardTableBarrierSetC1.cpp","additions":1,"deletions":4,"binary":false,"changes":5,"status":"modified"},{"patch":"@@ -148,1 +148,0 @@\n-#if INCLUDE_CDS\n@@ -154,1 +153,0 @@\n-#endif\n","filename":"src\/hotspot\/share\/gc\/shared\/c2\/cardTableBarrierSetC2.cpp","additions":0,"deletions":2,"binary":false,"changes":2,"status":"modified"},{"patch":"@@ -135,1 +135,0 @@\n-#if INCLUDE_CDS\n@@ -144,1 +143,0 @@\n-#endif\n@@ -579,1 +577,0 @@\n-#if INCLUDE_CDS\n@@ -583,1 +580,0 @@\n-#endif \/\/ INCLUDE_CDS\n","filename":"src\/hotspot\/share\/interpreter\/rewriter.cpp","additions":0,"deletions":4,"binary":false,"changes":4,"status":"modified"},{"patch":"@@ -854,1 +854,1 @@\n-    CDS_ONLY(AOTMetaspace::print_on(&ls);)\n+    AOTMetaspace::print_on(&ls