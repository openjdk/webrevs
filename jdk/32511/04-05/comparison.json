native, it could be that the stack frames are not\n-  \/\/ yet safe to use. We catch such situations in the subsequent stack watermark\n-  \/\/ barrier, which will trap unsafe stack frames.\n-  StackWatermarkSet::before_unwind(thread);\n-\n-  thread->set_thread_state(_thread_in_Java);\n-}\n-\n","filename":"src\/hotspot\/share\/runtime\/javaThread.cpp","additions":0,"deletions":22,"binary":false,"changes":22,"status":"modified"},{"patch":"@@ -669,3 +669,0 @@\n-  \/\/ Check for async exception in addition to safepoint.\n-  static void check_special_condition_for_native_trans(JavaThread *thread);\n-\n","filename":"src\/hotspot\/share\/runtime\/javaThread.hpp","additions":0,"deletions":3,"binary":false,"changes":3,"status":"modified"},{"patch":"@@ -4218,0 +4218,12 @@\n+\n+\/\/ Slow path when the native==>Java barriers detect a safepoint\/handshake is\n+\/\/ pending, when _suspend_flags is non-zero or when we need to process a stack\n+\/\/ watermark. Also check for pending async exceptions (except unsafe access error).\n+JRT_ENTRY(void, SharedRuntime::check_special_condition_for_native_trans(JavaThread *current))\n+  assert(!thread->has_last_Java_frame() || thread->frame_anchor()->walkable(), \"Unwalkable stack in native->Java transition\");\n+\n+  \/\/ After returning from native, it could be that the stack frames are not\n+  \/\/ yet safe to use. We catch such situations in the subsequent stack watermark\n+  \/\/ barrier, which will trap unsafe stack frames.\n+  StackWatermarkSet::before_unwind(current);\n+JRT_END\n","filename":"src\/hotspot\/share\/runtime\/sharedRuntime.cpp","additions":12,"deletions":0,"binary":false,"changes":12,"status":"modified"},{"patch":"@@ -693,0 +693,4 @@\n+\n+  \/\/ native --> Java safepoint entry point\n+  \/\/ Check for async exception in addition to safepoint.\n+  static void check_special_condition_for_native_trans(JavaThread *current);\n","filename":"src\/hotspot\/share\/runtime\/sharedRuntime.hpp","additions":4,"deletions":0,"binary":false,"changes":4,"status":"modified"}]}