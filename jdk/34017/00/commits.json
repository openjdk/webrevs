[{"commit":{"message":"6968794: rewiring test\n\nFixing a NPE from workerThread.get(), and generally tidying up the order everything is checked."},"files":[{"filename":"test\/jdk\/sun\/awt\/image\/png\/PngImageDecoderPrematureEOFTest.java"}],"sha":"e56ed90fe2fe3dedb81fe8462a60251ef59f6564"},{"commit":{"message":"6968794: don't call imageComplete() here\n\nThis resulted in a redundant call to `imageComplete`. When we throw it: the caller will *also* call `imageComplete`, so this call is unnecessary."},"files":[{"filename":"src\/java.desktop\/share\/classes\/sun\/awt\/image\/PNGImageDecoder.java"}],"sha":"ab0ab56236341bcacfde01ba1279e983d96fac0b"},{"commit":{"message":"6968794: flag redundant imageComplete as failure"},"files":[{"filename":"test\/jdk\/sun\/awt\/image\/png\/PngImageDecoderPrematureEOFTest.java"}],"sha":"169ac58cd3b6df879c4091b81951e1281dc85131"},{"commit":{"message":"6968794: small code review nits"},"files":[{"filename":"test\/jdk\/sun\/awt\/image\/png\/PngImageDecoderPrematureEOFTest.java"}],"sha":"f772eab32a24f2aa5fd124b6ef04a75d1db47f15"},{"commit":{"message":"6968794: adding reachabilityFence\n\nClaude reviewed this and noticed ImageObservers are only weakly referenced. Since `observer` is a local var, we need to keep the GC from reclaiming it."},"files":[{"filename":"test\/jdk\/sun\/awt\/image\/png\/PngImageDecoderPrematureEOFTest.java"}],"sha":"052f3183291dc91909c42460faef05670dc0a0ed"},{"commit":{"message":"6968794: fix imageComplete(k) call\n\nUsing `ImageConsumer.IMAGEERROR|ImageConsumer.STATICIMAGEDONE` is just `1|3`, which evaluates to `3`. As far as all consumers are concerned: we are calling `imageComplete(STATICIMAGEDONE)` for an error.\n\n(The previous authors probably confused iamgeComplete notifications with hints. ImageConsumer hint constants *can* be OR'ed together, but completion constants can't.)"},"files":[{"filename":"src\/java.desktop\/share\/classes\/sun\/awt\/image\/PNGImageDecoder.java"}],"sha":"8812c1a61a5071cf913e42baf9a268204641530d"},{"commit":{"message":"6968794: add comment about dimensions"},"files":[{"filename":"test\/jdk\/sun\/awt\/image\/png\/PngImageDecoderPrematureEOFTest.java"}],"sha":"73b4004fe198ae11209c8f9f45dbd980391f747c"},{"commit":{"message":"6968794: first draft of failing unit test"},"files":[{"filename":"test\/jdk\/sun\/awt\/image\/png\/PngImageDecoderPrematureEOFTest.java"}],"sha":"5c2055c7eb8498ab35451ed2bcfdde9bed94336b"},{"commit":{"message":"Merge remote-tracking branch 'origin\/master'"},"files":[],"sha":"b4646c660f0733bba575737f92914d94ad1e2739"},{"commit":{"message":"8395707: fixing mistaken commit"},"files":[],"sha":"7311ff134b23e53d81757404c94ed23a28355251"},{"commit":{"message":"Merge branch 'master' of https:\/\/github.com\/mickleness\/jdk"},"files":[],"sha":"074b8250af9ad90a80d5583dc8babb96eb6c0475"},{"commit":{"message":"Merge branch 'master' of https:\/\/github.com\/mickleness\/jdk\n\n# Conflicts:\n#\ttest\/jdk\/javax\/accessibility\/8385367\/TestAddingOldAccessibleContextAsDocumentListener.java"},"files":[],"sha":"2f8b05f804ecb23f315edc0ff1406b188ff6c6ad"},{"commit":{"message":"Merge branch 'openjdk:master' into master"},"files":[],"sha":"f6c414b1ddb50ad5343c8f2d77dfe41b82d5c92f"},{"commit":{"message":"8385367: stop using stale\/orphaned AccessibleContext"},"files":[],"sha":"35603a7b3b72527e56015431aabd5469bab6d6fe"}]