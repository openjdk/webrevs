8a1"},{"commit":{"message":"Review comments from @jayathirthrao, update Buffer initialization\n\n- Fixed MSAA support polling\n- Adjusted code initializing Internal::Buffer:\n  - Now Buffer::Init will only initialize data when we create an\n    UPLOAD-heap Buffer for convenienice\n  - DEFAULT-heap Buffers now require manual update via RenderingContext\n  - RenderingContext, similar to Textures, employs a fast path for small\n    Buffers utilizing preallocated memory\n- NativeMesh will now reuse existing VB\/IB if BuildGeometryBuffers uses\n  the same buffer size with new data"},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12Constants.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeMesh.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeMesh.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12Buffer.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12Buffer.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/render-thread\/D3D12RenderThreadContext.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/render-thread\/D3D12RenderThreadContext.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/render-thread\/D3D12RenderThreadExecutable.hpp"}],"sha":"2e8f21665850207464dc7bbee8b07a2615bbfe2d"},{"commit":{"message":"RTContext: Fix potential quad VB data overwrite\n\nMain Ring Buffer data should be declared before use, together with\nResourceManager's data."},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/render-thread\/D3D12RenderThreadContext.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/render-thread\/D3D12RenderThreadContext.hpp"}],"sha":"0dd052f4d03cac37d82da4229ed36c2ce4c90fd0"},{"commit":{"message":"Review fixes from @kevinrushforth"},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/D3D12RTTexture.java"},{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/D3D12Texture.java"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeInstance.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12DescriptorHeap.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12TextureBase.hpp"}],"sha":"92f39fa12db1cc45c0d8cd3ed4e0a0198ab93d66"},{"commit":{"message":"RenderingContext: Fix Clear opts not triggering\n\nAlways checking for valid RTT's dirty bbox caused the opt to never\ntrigger"},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.cpp"}],"sha":"f8f3c0ce2e182b50842b1047161c9adddbc131f8"},{"commit":{"message":"MeshView: Use weak_ptr for Mesh and Material references\n\nChanged in-line with NativePhongMaterial change in previous commit"},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeMeshView.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeMeshView.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/render-thread\/D3D12RenderThreadExecutable.hpp"}],"sha":"44a660c90b70ae2f1d04da0bb5809bde38ce7738"},{"commit":{"message":"Review fixes from general comments from @kevinrushforth\n\n- D3D12Context.java correctly handles NULL destination RTT now\n- D3D12SwapChain.java prevents potential NPE when disposing\n- D3D12RenderingContext.cpp:\n  - Shader assignments are now checked based on stored Shader parameter\n    instead of PSO's bound Shader (fixes incorrect shader resource\n    assignments after restoring the Context after Blit)\n  - Clear now handles dirty bboxes better (fixes unnecessary and\/or\n    incorrect bbox estimation)\n- D3D12Graphics.java now provides premultiplied clear parameters\n- D3D12NativeSwapChain.cpp now checks for tearing support when VSync is\n  requested disabled, will fall-back to enabled VSync if device does not\n  support it or we cannot poll DXGI for support\n- D3D12NativeRenderTarget.cpp sets underlying Texture's sampling to\n  linear to match D3D's settings\n- D3D12NativePhongMaterial.cpp now uses weak pointers to refer to\n  texture maps - prevents keeping strong references and keeping the\n  resources alive despite NativeTexture being released\n\nAdditionally:\n- Added logic to unbind Textures from RenderingContext when they are\n  disposed\n- Added a missing Clear call to createRTTexture (found it in D3D backend)\n- RenderPerfTest will respect java.animation.fullspeed pre-set when\n  it is set via a JVM argument"},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/D3D12Graphics.java"},{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/D3D12ResourceFactory.java"},{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/D3D12SwapChain.java"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12Common.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativePhongMaterial.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeRenderTarget.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeSwapChain.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeSwapChain.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.hpp"},{"filename":"tests\/performance\/animation\/RenderPerfTest\/src\/renderperf\/RenderPerfTest.java"}],"sha":"e8aaed19ce048fa234bf7c2f8aa3e33388864aee"},{"commit":{"message":"DXGIFormat: Remove extra newline"},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/ni\/DXGIFormat.java"}],"sha":"a6396d87e223aee3030ab1a7c964c446c16d9170"},{"commit":{"message":"Review comments from @crschnick\n\nDoesn't contain SwapChain flag adjustment, as this will be solved\nseparately with SwapChain changes requested by @kevinrushforth"},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/D3D12Context.java"},{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/ni\/D3D12NativeDevice.java"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingStep.hpp"}],"sha":"dc8519a685ca0b9cd2601d7f1b7f3d81539303e7"},{"commit":{"message":"Update CompileHLSL6Task to latest build fixes"},"files":[{"filename":"buildSrc\/src\/main\/groovy\/com\/sun\/javafx\/gradle\/CompileHLSL6Task.groovy"}],"sha":"d928c7d4d91c5244e17837f061d9a5ecd2f7f3a4"},{"commit":{"message":"Merge remote-tracking branch 'upstream\/master' into feature\/direct3d12"},"files":[],"sha":"0e331c4c3879ef17d96a73df4e264ec6e1999d8c"},{"commit":{"message