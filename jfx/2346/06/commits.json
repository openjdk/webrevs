[{"commit":{"message":"Disable Scissor testing when switching to 3D\n\nThere are some very select corner-cases (ex. when rendering 2D over a 3D\nscene) where Prism expects 3D rendering to start with Scissor testing\ndisabled.\n\nThis patch adds D3D12Context.setDeviceParametersFor3D() override which\nalways disables scissor testing. This mirrors D3D behavior and causes\nthe 3D scene RTT to be properly cleared in those cases."},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/D3D12Context.java"},{"filename":"modules\/javafx.graphics\/src\/main\/java\/com\/sun\/prism\/d3d12\/ni\/D3D12NativeDevice.java"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.cpp"}],"sha":"74de17601d2cf352e699678b05645dc040f7d811"},{"commit":{"message":"Review comments from @Maran23"},"files":[{"filename":"buildSrc\/win.gradle"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeLibrary.cpp"}],"sha":"b8ece366ac662ba172249f760022f29f37a4c31e"},{"commit":{"message":"Device\/Context: Remove UnsetTextureIfSet\n\nThis caused scrolling issues in WebView. Scrolling there is done by:\n- Creating a temp RTT\n- Copying contents to the RTT\n- Redrawing the temp RTT onto actual WebPage RTT shifted\n- Immediately after disposing of the temp RTT by calling dispose()\n\nThe last step caused the Texture to be unbound and because we cache the\ndraw calls and batch-submit them, caused the final redraw to fail.\n\nNativeTexture is held by a shared_ptr instance so it will eventually get\nfreed anyway once the instances on the Render Thread side get replaced."},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.hpp"}],"sha":"28402902d303168fe17b6c290ed10d969135132d"},{"commit":{"message":"PSOManager: Add missing Rasterizer State MSAA flag"},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/render-thread\/D3D12PSOManager.cpp"}],"sha":"0b5e8f73a6c4be20fb05b12dde80b5cc9668b01f"},{"commit":{"message":"Cleanup magic numbers and constants\n\n- Added new \"common\" header - D3D12Types.hpp - which holds all extra\n  structs\/classes\/enums used by the backend. This will always be\n  included by D3D12Common.hpp.\n- Moved constants and constant macros from D3D12Common to\n  D3D12Constants.hpp\n- Replaced constant macros with regular constants for type safety and\n  namespacing"},"files":[{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12Common.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12Constants.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeDevice.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeInstance.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12NativeShader.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/D3D12Types.hpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/internal\/D3D12RenderingContext.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/render-thread\/D3D12CommandListPool.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-prism-d3d12\/render-thread\/D3D12RenderThread.cpp"},{"filename":"modules\/javafx.graphics\/src\/main\/native-pris