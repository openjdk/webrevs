[{"commit":{"message":"Backport 151f708c26c665de1a50f4757580326fbf870297\n\n8355779: When no \"signature_algorithms_cert\" extension is present we do not apply certificate scope constraints to algorithms in \"signature_algorithms\" extension"},"files":[{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/SignatureAlgorithmsExtension.java"}],"sha":"bc29233f17ed77aad5adefd942fc50309b936739"},{"commit":{"message":"Correct jcheck errors"},"files":[{"filename":"jdk\/test\/sun\/security\/ssl\/SignatureScheme\/DisableSignatureSchemePerScopeTLS13.java"}],"sha":"91fcc834127df5f6bdca8dd36ada9178a94aa438"},{"commit":{"message":"Fix JDK build when generating the symbols file\n\nWhen ct.sym is being generated by the CreateSymbols annotation\nprocessor, generation fails when trying to process\nDisabledAlgorithmConstraints class since SSLScope doesn't exist in the\nboot JDK (it's introduced in this patch).\n\nFix the issue by adding a minimal extra boot class path for the boot JDK\nwith just the added class. This will no longer be needed once an 8u512\nbuild has been released with the class included in rt.jar"},"files":[{"filename":"common\/autoconf\/spec.gmk.in"},{"filename":"jdk\/make\/CopyFiles.gmk"},{"filename":"jdk\/make\/CreateJars.gmk"}],"sha":"fb271a00eb2b223d79bc88a8f8d9be900bcf9f60"},{"commit":{"message":"Backport 257efa5af5d962ef9b10af7123a0db916fd4ef06\n\n8349583: Add mechanism to disable signature schemes based on their TLS scope\n\nSince 'JDK-8226374: Restrict TLS signature schemes and named groups' is\nnot in 8u, take minimal parts from it to update SignatureScheme:\n - use 'SigAlgParamSpec signAlgParams' over 'AlgorithmParameterSpec\n   signAlgParameter' field.\n - Update usages of 'getPreferableAlgorithm()'\n   and 'getSignerOfPreferableAlgorithm()' in:\n   CertificateVerify, DHServerKeyExchange, ECDHServerKeyExchange,\n   CertificateRequest and CertificateMessage passing in SSLAlgorithmConstraints\n   as an extra parameter.\n - Add 'isPermitted()' without the extra bit added by JDK-8226374.\n - Update 'SignatureUtil.initVerifyWithParam()' with the change of the\n   'signAlgParams' field.\n\nThe change to java.security-* is duplicated to all versions.\nSince '8341964: Add mechanism to disable different parts of TLS cipher suite' is not\na dependency only include the relevant parts for JDK-8349583.\n\nVarious test changes to adapt to 8u library code:\n - \/test\/lib => \/lib\/testlibrary\n - Utils.java is in jdk.testlibrary.Utils package in 8u.\n - Remove DTLS 1.2 test which isn't supported in 8u TLS 1.3\n - Change usage of Map.ofEntries() which is only JDK 11+ API\n - Change usage of List.of() which is only in JDK 11+ API\n\nOther changes:\n - Set.of(x) => Collections.unmodifiableSet(EnumSet.of(x))"},"files":[{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/CertSignAlgsExtension.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/CertificateMessage.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/CertificateRequest.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/CertificateVerify.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/DHServerKeyExchange.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/ECDHServerKeyExchange.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/HandshakeContext.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/PostHandshakeContext.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/PreSharedKeyExtension.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/SSLAlgorithmConstraints.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/SSLScope.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/SSLSessionImpl.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/ServerHello.java"},{"filename":"jdk\/src\/share\/classes\/sun\/security\/ssl\/SignatureAlgorithmsExtension.java"},{"filename":"jdk\/src\/share\/classes\/s